generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// AUTH & USER MODELS
// ==========================================

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  imageId       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  role          Role          @default(USER)
  phone         String
  sessions      Session[]
  accounts      Account[]
  reservations  Reservation[]
  reviews       Review[]
  orders        Order[]      

  @@map("user")
}

enum Role {
  USER       
  STAFF      
  KITCHEN    
  MANAGER    
  ADMIN      
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ==========================================
// RESTAURANT DOMAIN MODELS
// ==========================================

model Category {
  id           String     @id @default(cuid())
  slug         String     @unique 
  name         String     
  description  String?
  image        String
  imageId      String?
  displayOrder Int        @default(0)
  menuItems    MenuItem[]

  @@map("category")
}

model MenuItem {
  id          String              @id @default(cuid())
  name        String
  description String
  price       Int
  image       String
  imageId     String?
  isPopular   Boolean             @default(false)
  isExclusive Boolean             @default(false)
  isSpecial   Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  categoryId  String
  category    Category            @relation(fields: [categoryId], references: [id])

  provenance  MenuItemProvenance?
  orderItems  OrderItem[]        

  @@map("menu_item")
}

model MenuItemProvenance {
  id         String   @id @default(cuid())
  title      String
  origin     String
  details    String
  image      String
  imageId    String?
  menuItemId String   @unique
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@map("menu_item_provenance")
}

model Review {
  id        String   @id @default(cuid())
  text      String
  name      String
  role      String
  rating    Int
  status    ReviewStatus @default(PENDING)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("review")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==========================================
// ORDER MODELS (Нарачки од најавени корисници)
// ==========================================

enum OrderStatus {
  PENDING       // Внесена нарачка
  CONFIRMED     // Потврдена од ресторан
  PREPARING     // Се подготвува во кујна
  READY         // Подготвена за подигање / преземање од доставувач
  IN_TRANSIT    // Доставувачот е на пат
  DELIVERED     // Доставена
  CANCELLED     // Откажана
}
enum DeliveryMethod {
  ADDRESS      // Достава до адреса
  PICKUP        // Лично подигање
}

enum PaymentMethod {
  CASH          // Готовина
  CARD          // Картичка
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
 
  subtotal        Int            
  deliveryFee     Int            @default(0) 
  total           Int
  
  status          OrderStatus    @default(PENDING)
  paymentMethod   PaymentMethod  @default(CASH)
  paymentStatus   PaymentStatus  @default(PENDING)
  deliveryMethod  DeliveryMethod @default(ADDRESS)

  customerName    String?
  phone           String
  deliveryAddress String?  
  latitude        Float?
  longitude       Float?      
  notes           String?        

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  items           OrderItem[]

  @@index([userId])
  @@index([status])
  @@map("order")
}

model OrderItem {
  id         String   @id @default(cuid())
  quantity   Int
  price      Int      
  name       String   

  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  @@map("order_item")
}

// ==========================================
// RESERVATIONS
// ==========================================

model TableType {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  tables      Table[]

  @@map("table_type")
}

model Table {
  id           String        @id @default(cuid())
  number       String        @unique
  capacity     Int
  tableTypeId  String
  tableType    TableType     @relation(fields: [tableTypeId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  @@index([tableTypeId, capacity])
  @@map("table")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Reservation {
  id              String    @id @default(cuid())
  guests          Int
  name            String
  phone           String
  email           String
  specialRequests String?
  status          ReservationStatus @default(PENDING)
  durationMinutes Int               @default(90)
  startTime       DateTime
  endTime         DateTime

  tableId         String
  table           Table     @relation(fields: [tableId], references: [id], onDelete: Restrict)

  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tableId, startTime, endTime])
  @@index([startTime, endTime, status])
  @@index([userId, startTime])
  @@map("reservation")
}

model WorkingHours {
  id        String  @id @default(uuid())
  dayOfWeek Int     @unique
  isWorking Boolean @default(true)
  slots     Json

  @@map("working_hours")
}

model ScheduleOverride {
  id         String  @id @default(uuid())
  dateString String  @unique
  isWorking  Boolean
  slots      Json
  reason     String?

  @@map("schedule_override")
}
